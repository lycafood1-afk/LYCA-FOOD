# Add in Vercel dashboard -> your ADMIN project -> Settings -> Environment Variables.
# Use the Production environment. These example values are not credentials.
LYCA_SITE_ROLE=admin
DATABASE_URL=YOUR_PRIVATE_NEON_CONNECTION_STRING
BLOB_READ_WRITE_TOKEN=TOKEN_FOR_THE_SHARED_PUBLIC_BLOB_STORE
CUSTOMER_SITE_URL=https://YOUR-CUSTOMER-PROJECT.vercel.app
# Generate these three values locally: node scripts/create-admin.mjs
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD_HASH=GENERATED_PASSWORD_HASH
SESSION_SECRET=GENERATED_SESSION_SECRET
