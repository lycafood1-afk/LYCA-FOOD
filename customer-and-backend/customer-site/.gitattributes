# Website assets ship directly in Git so every deployment receives real bytes.
* text=auto
*.bat text eol=crlf
*.png -text -filter -diff -merge
*.jpg -text -filter -diff -merge
*.jpeg -text -filter -diff -merge
*.webp -text -filter -diff -merge
*.ttf -text -filter -diff -merge
*.woff -text -filter -diff -merge
*.woff2 -text -filter -diff -merge
